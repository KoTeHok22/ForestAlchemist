/* Shared App UI control styling inside settings scroll areas */

.settings-scroll .form-row {
    margin-bottom: 22px;
}

.settings-scroll .form-label,
.settings-scroll .setting-toggle-label {
    font-size: 32px;
    margin-bottom: 10px;
}

.settings-scroll .section-title {
    font-size: 42px;
    margin-top: 24px;
    margin-bottom: 16px;
}

.settings-scroll .setting-toggle-row {
    min-height: 64px;
    padding: 14px 0;
    margin-bottom: 8px;
}

.settings-scroll .form-input {
    min-height: 56px;
}

/* Dropdown trigger + menu */
.settings-scroll Dropdown,
.settings-scroll .appui-dropdown {
    min-height: 56px;
    font-size: 28px;
}

.settings-scroll .appui-dropdown__trigger {
    min-height: 56px;
    background-color: rgba(42, 28, 12, 0.92);
    border-width: 2px;
    border-color: rgba(122, 63, 18, 0.95);
    border-radius: 10px;
    padding-left: 18px;
    padding-right: 18px;
}

.settings-scroll .appui-dropdown__trigger Label,
.settings-scroll .appui-dropdown__trigger .appui-text,
.settings-scroll .appui-dropdown__value {
    color: #f4ead2;
    font-size: 28px;
    -unity-font-style: bold;
}

.settings-scroll .appui-dropdown__menu {
    background-color: rgba(32, 20, 8, 0.98);
    border-width: 2px;
    border-color: #7a3f12;
    border-radius: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.settings-scroll .appui-menu-item,
.settings-scroll .appui-dropdown-item {
    min-height: 52px;
    font-size: 26px;
    color: #f4ead2;
    padding-left: 16px;
    padding-right: 16px;
}

.settings-scroll .appui-menu-item:hover,
.settings-scroll .appui-dropdown-item:hover {
    background-color: rgba(122, 63, 18, 0.55);
}

/* Toggles */
.settings-scroll Toggle,
.settings-scroll .appui-toggle {
    width: 88px;
    height: 48px;
    flex-shrink: 0;
}

.settings-scroll .appui-toggle__input {
    width: 88px;
    height: 48px;
}

.settings-scroll .appui-toggle__track {
    width: 88px;
    height: 48px;
    border-radius: 24px;
    background-color: rgba(55, 36, 18, 0.95);
    border-width: 2px;
    border-color: #5a3d22;
}

.settings-scroll .appui-toggle--checked .appui-toggle__track,
.settings-scroll .appui-toggle:checked .appui-toggle__track {
    background-color: #3d8a4a;
    border-color: #2f6b38;
}

.settings-scroll .appui-toggle__thumb {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: #f4ead2;
    border-width: 2px;
    border-color: #c9a86a;
}

/* Sliders */
.settings-scroll SliderFloat,
.settings-scroll .appui-slider {
    min-height: 52px;
    margin-top: 6px;
    margin-bottom: 10px;
}

.settings-scroll .appui-slider__track {
    height: 14px;
    border-radius: 7px;
    background-color: rgba(55, 36, 18, 0.85);
    border-width: 2px;
    border-color: #5a3d22;
}

.settings-scroll .appui-slider__fill {
    background-color: #7a3f12;
    border-radius: 7px;
}

.settings-scroll .appui-slider__dragger,
.settings-scroll .unity-base-slider__dragger {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: #f4ead2;
    border-width: 2px;
    border-color: #c9a86a;
}

.control-bind-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 58px;
    margin-bottom: 8px;
    padding-right: 4px;
}

.control-bind-label {
    flex-grow: 1;
    color: #3d2812;
    font-size: 28px;
    -unity-font-style: bold;
    margin-right: 12px;
}

.control-bind-btn {
    min-width: 132px;
    min-height: 52px;
    padding-left: 16px;
    padding-right: 16px;
    align-items: center;
    justify-content: center;
    background-color: rgba(42, 28, 12, 0.92);
    border-width: 2px;
    border-color: rgba(122, 63, 18, 0.95);
    border-radius: 10px;
}

.control-bind-btn:hover {
    background-color: rgba(74, 48, 24, 0.95);
    scale: 1.03 1.03;
}

.control-bind-btn--active {
    border-color: #ffd877;
    background-color: rgba(122, 63, 18, 0.75);
}

.control-bind-btn__text {
    color: #f4ead2;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.controls-rebind-status {
    color: #7a3f12;
    font-size: 22px;
    -unity-font-style: italic;
    min-height: 28px;
    margin-top: 8px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.controls-actions {
    flex-direction: column;
    align-items: center;
    margin-top: 12px;
}
