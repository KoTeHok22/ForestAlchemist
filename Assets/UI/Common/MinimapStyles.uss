.minimap-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0);
    -unity-font: url("project://database/Assets/Resources/Menu/Fonts/arturito.ttf");
    -unity-font-definition: url("project://database/Assets/Resources/Menu/Fonts/arturito.ttf");
}
.minimap-root > .appui-panel__main { background-color: rgba(0,0,0,0); }

.minimap-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 8, 0.45);
}

.minimap-overlay.hidden { display: none; }

.minimap-frame {
    width: 820px;
    height: 920px;
    padding: 44px 50px 36px 50px;
    align-items: center;
    justify-content: flex-start;
    background-image: resource("Menu/Generated/minimap_paper");
    -unity-background-scale-mode: scale-to-fit;
}

.minimap-title {
    color: #3d2d1d;
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.minimap-hint {
    color: rgba(60, 44, 28, 0.75);
    font-size: 16px;
    margin-bottom: 10px;
}

.minimap-map-wrap {
    width: 720px;
    height: 720px;
}

.minimap-north {
    position: absolute;
    top: 10px;
    left: 50%;
    translate: -50% 0;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
}

.minimap-north__label {
    color: #2f2418;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.minimap-markers {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.minimap-player {
    position: absolute;
    width: 28px;
    height: 28px;
    background-image: resource("Menu/Generated/minimap_icon_player");
    -unity-background-scale-mode: scale-to-fit;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

.minimap-marker {
    position: absolute;
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    translate: -50% -50%;
}

.minimap-marker--evacuation { background-image: resource("Menu/Generated/minimap_icon_evacuation"); }
.minimap-marker--portal { background-image: resource("Menu/Generated/minimap_icon_portal"); }
.minimap-marker--altar-fire { background-image: resource("Menu/Generated/minimap_icon_altar_fire"); }
.minimap-marker--altar-water { background-image: resource("Menu/Generated/minimap_icon_altar_water"); }
.minimap-marker--other { background-image: resource("Menu/Generated/minimap_icon_evacuation"); }

.minimap-legend {
    margin-top: 14px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
}

.minimap-legend__item {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 4px;
}

.minimap-legend__dot {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.minimap-legend__dot--player { background-image: resource("Menu/Generated/minimap_icon_player"); }
.minimap-legend__dot--evacuation { background-image: resource("Menu/Generated/minimap_icon_evacuation"); }
.minimap-legend__dot--portal { background-image: resource("Menu/Generated/minimap_icon_portal"); }
.minimap-legend__dot--altar-fire { background-image: resource("Menu/Generated/minimap_icon_altar_fire"); }
.minimap-legend__dot--altar-water { background-image: resource("Menu/Generated/minimap_icon_altar_water"); }

.minimap-legend__label {
    color: #3d2d1d;
    font-size: 16px;
}
