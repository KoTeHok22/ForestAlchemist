/* Forest Alchemist - HUD styles (App UI) */

.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0);
    -unity-font: url("project://database/Assets/Resources/Menu/Fonts/arturito.ttf");
    -unity-font-definition: url("project://database/Assets/Resources/Menu/Fonts/arturito.ttf");
}
.hud-root > .appui-panel__main { background-color: rgba(0,0,0,0); }

.hud-player {
    position: absolute;
    top: 20px;
    left: 20px;
    flex-direction: row;
    align-items: center;
}

.portrait {
    width: 240px;
    height: 240px;
    align-items: center;
    justify-content: center;
    margin-right: 4px;
    background-image: resource("Menu/Generated/portrait");
    -unity-background-scale-mode: scale-to-fit;
}

.portrait-fill { display: none; }

.portrait-ring { display: none; }

.portrait-badge {
    position: absolute;
    color: #2b2b2b;
    font-size: 76px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-stats {
    flex-direction: column;
    justify-content: center;
    padding: 30px 44px 30px 44px;
    background-image: resource("Menu/Generated/statpanel");
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 120;
    -unity-slice-bottom: 120;
    -unity-slice-scale: 0.32px;
}

.hearts {
    flex-direction: row;
    margin-bottom: 16px;
}

.heart {
    width: 76px;
    height: 76px;
    margin-right: 10px;
    background-image: resource("Menu/Generated/heart");
    -unity-background-scale-mode: scale-to-fit;
}

.heart--empty {
    opacity: 0.28;
}

.stat-bar {
    width: 460px;
    height: 32px;
    margin-bottom: 10px;
    background-color: rgba(12, 9, 5, 0.85);
    border-radius: 10px;
    border-width: 3px;
    border-color: rgba(0,0,0,0.6);
    overflow: hidden;
}

.stat-bar__fill {
    height: 100%;
    width: 100%;
    border-radius: 4px;
}

.stat-bar--stamina .stat-bar__fill { background-color: #6fcf4f; }
.stat-bar--mana .stat-bar__fill { background-color: #4f9ddf; }
.stat-bar--shield .stat-bar__fill { background-color: #d9c24a; }

.hud-hotbar {
    position: absolute;
    bottom: 18px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

/* wooden strip wrapping the slots */
.hud-hotbar__strip {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    background-color: rgba(74, 50, 28, 0.95);
    border-radius: 16px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-color: rgba(40, 26, 14, 0.95);
}

.hotbar-slot {
    width: 84px;
    height: 84px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(120, 86, 50, 0.55);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(40, 26, 14, 0.85);
    align-items: center;
    justify-content: center;
}

.hotbar-slot__icon {
    width: 80%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.hotbar-slot__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(10, 16, 26, 0.66);
}

.hotbar-slot__hotkey {
    display: none;
}

.hud-quests {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 360px;
    flex-direction: column;
}

.quest-row {
    background-color: rgba(30, 20, 12, 0.72);
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: #ffd877;
    padding: 8px 12px;
    margin-bottom: 6px;
}

.quest-row__title {
    color: #fff2cf;
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.quest-row__progress {
    color: #d6c69b;
    font-size: 15px;
    margin-top: 2px;
}
