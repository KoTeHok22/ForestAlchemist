<?xml version="1.0" encoding="utf-8"?>
<UXML xmlns="UnityEngine.UIElements"
      xmlns:appui="Unity.AppUI.UI"
      xmlns:ui="UnityEngine.UIElements">

    <Style src="MainMenuStyles.uss" />

    <appui:Panel name="root-panel" class="root-panel" theme="dark" scale="medium">

        <!-- Full-screen forest background -->
        <ui:VisualElement name="background-layer" class="background-layer" picking-mode="Ignore" />

        <!-- ================= MAIN MENU SCREEN ================= -->
        <ui:VisualElement name="screen-main" class="screen screen--main" picking-mode="Ignore">

            <!-- Game logo top-left -->
            <ui:VisualElement name="logo" class="logo" picking-mode="Ignore" />

            <!-- Account chip top-right (wooden plate with nickname) -->
            <ui:VisualElement name="account-chip" class="account-chip">
                <ui:VisualElement name="account-icon" class="account-icon" picking-mode="Ignore" />
                <ui:Label name="account-label" text="Гость" class="account-label" />
                <ui:VisualElement name="account-button-hit" class="account-button-hit" />
            </ui:VisualElement>

            <!-- Settings gear bottom-right -->
            <ui:VisualElement name="settings-gear" class="settings-gear">
                <ui:VisualElement name="settings-gear-hit" class="settings-gear-hit" />
            </ui:VisualElement>

            <!-- Soft shadow grounding the button column -->
            <ui:VisualElement name="button-backing" class="button-backing" picking-mode="Ignore" />

            <!-- Stacked wooden buttons left side -->
            <ui:VisualElement name="main-buttons" class="main-buttons" picking-mode="Position">
                <ui:VisualElement name="btn-new-game" class="wood-btn">
                    <ui:Label text="Новая игра" class="wood-btn__label" />
                </ui:VisualElement>
                <ui:VisualElement name="btn-continue" class="wood-btn">
                    <ui:Label text="Продолжить" class="wood-btn__label" />
                </ui:VisualElement>
                <ui:VisualElement name="btn-records" class="wood-btn">
                    <ui:Label text="Рекорды" class="wood-btn__label" />
                </ui:VisualElement>
                <ui:VisualElement name="btn-exit" class="wood-btn">
                    <ui:Label text="Выход" class="wood-btn__label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Version stamp -->
            <ui:Label name="version-stamp" text="Pre-Alpha · v0.1" class="version-stamp" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ================= LOGIN SCREEN ================= -->
        <ui:VisualElement name="screen-login" class="screen screen--overlay">
            <ui:VisualElement class="dim-bg" />
            <ui:VisualElement class="wood-frame wood-frame--narrow">
                <ui:Label text="Алхимическая печать" class="frame-title" />
                <ui:Label text="Войди в свой профиль или создай новый" class="frame-subtitle" />

                <ui:VisualElement class="form-row">
                    <ui:Label text="Никнейм" class="form-label" />
                    <appui:TextField name="login-username" placeholder="Имя алхимика" class="form-input" />
                </ui:VisualElement>

                <ui:VisualElement class="form-row">
                    <ui:Label text="Пароль" class="form-label" />
                    <appui:TextField name="login-password" placeholder="Минимум 8 символов" password="true" class="form-input" />
                </ui:VisualElement>

                <ui:Label name="login-status" text="" class="form-status" />

                <ui:VisualElement class="form-actions form-actions--vertical">
                    <ui:VisualElement name="btn-do-login" class="wood-btn wood-btn--block">
                        <ui:Label text="Войти" class="wood-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-do-register" class="wood-btn wood-btn--block">
                        <ui:Label text="Регистрация" class="wood-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="btn-login-close" class="frame-close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= SETTINGS SCREEN ================= -->
        <ui:VisualElement name="screen-settings" class="screen screen--overlay">
            <ui:VisualElement class="dim-bg" />
            <ui:VisualElement class="wood-frame wood-frame--settings">
                <ui:Label text="Настройки" class="frame-title" />
                <ui:Label text="Графика, звук и режим окна" class="frame-subtitle" />

                <ui:ScrollView class="settings-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">

                    <ui:Label text="Графика" class="section-title" />

                    <ui:VisualElement class="form-row">
                        <ui:Label text="Разрешение" class="form-label" />
                        <appui:Dropdown name="settings-resolution" class="form-input settings-dropdown" />
                    </ui:VisualElement>

                    <ui:VisualElement class="form-row">
                        <ui:Label text="Качество" class="form-label" />
                        <appui:Dropdown name="settings-quality" class="form-input settings-dropdown" />
                    </ui:VisualElement>

                    <ui:VisualElement class="setting-toggle-row">
                        <ui:Label text="Оконный режим" class="setting-toggle-label" />
                        <appui:Toggle name="settings-windowed" class="settings-toggle" />
                    </ui:VisualElement>

                    <ui:Label text="Звук" class="section-title" />

                    <ui:VisualElement class="setting-toggle-row">
                        <ui:Label text="Музыка" class="setting-toggle-label" />
                        <appui:Toggle name="settings-music-enabled" class="settings-toggle" />
                    </ui:VisualElement>

                    <ui:VisualElement class="form-row">
                        <ui:Label text="Громкость музыки" class="form-label" />
                        <appui:SliderFloat name="settings-music-volume" low-value="0" high-value="1" value="1" show-input="true" format-string="P0" class="form-input settings-volume-slider" />
                    </ui:VisualElement>

                    <ui:VisualElement class="setting-toggle-row">
                        <ui:Label text="Звуковые эффекты" class="setting-toggle-label" />
                        <appui:Toggle name="settings-sfx-enabled" class="settings-toggle" />
                    </ui:VisualElement>

                    <ui:VisualElement class="form-row">
                        <ui:Label text="Громкость SFX" class="form-label" />
                        <appui:SliderFloat name="settings-sfx-volume" low-value="0" high-value="1" value="1" show-input="true" format-string="P0" class="form-input settings-volume-slider" />
                    </ui:VisualElement>

                    <ui:VisualElement class="form-actions form-actions--vertical">
                        <ui:VisualElement name="btn-open-controls" class="wood-btn wood-btn--block">
                            <ui:Label text="Управление" class="wood-btn__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Label name="account-section-title" text="Аккаунт" class="section-title" />

                    <ui:VisualElement name="account-actions" class="form-actions form-actions--vertical">
                        <ui:VisualElement name="btn-logout" class="wood-btn wood-btn--block">
                            <ui:Label text="Выйти из аккаунта" class="wood-btn__label wood-btn__label--tight" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>

                <ui:VisualElement name="btn-settings-close" class="frame-close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= CONTROLS SCREEN ================= -->
        <ui:VisualElement name="screen-controls" class="screen screen--overlay">
            <ui:VisualElement class="dim-bg" />
            <ui:VisualElement class="wood-frame wood-frame--settings">
                <ui:Label text="Управление" class="frame-title" />
                <ui:Label text="Назначьте клавиши и кнопки мыши" class="frame-subtitle" />

                <ui:ScrollView name="controls-list" class="settings-scroll controls-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />

                <ui:Label name="controls-rebind-status" text="" class="controls-rebind-status" />

                <ui:VisualElement class="controls-actions">
                    <ui:VisualElement name="btn-controls-reset" class="wood-btn wood-btn--block">
                        <ui:Label text="Сбросить по умолчанию" class="wood-btn__label wood-btn__label--tight" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-controls-back" class="wood-btn wood-btn--block">
                        <ui:Label text="Назад" class="wood-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= RECORDS SCREEN ================= -->
        <ui:VisualElement name="screen-records" class="screen screen--overlay">
            <ui:VisualElement class="dim-bg" />
            <ui:VisualElement class="wood-frame">
                <ui:Label text="Таблица рекордов" class="frame-title" />
                <ui:Label text="Лучшие алхимики леса" class="frame-subtitle" />

                <ui:VisualElement class="records-header">
                    <ui:Label text="#" class="records-col records-col--rank" />
                    <ui:Label text="Алхимик" class="records-col records-col--name" />
                    <ui:Label text="Ур." class="records-col records-col--level" />
                    <ui:Label text="Очки" class="records-col records-col--score" />
                </ui:VisualElement>

                <ui:ScrollView name="records-list" class="records-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />

                <ui:VisualElement name="btn-records-close" class="frame-close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= LOAD SCREEN ================= -->
        <ui:VisualElement name="screen-load" class="screen screen--overlay screen--load">
            <ui:VisualElement class="dim-bg dim-bg--strong" />
            <ui:VisualElement class="load-content">
                <ui:Label text="Подготовка экспедиции" class="load-title" />
                <ui:Label text="Алхимик собирает котомку…" class="load-subtitle" />
                <appui:CircularProgress name="load-spinner" size="L" class="load-spinner" />
                <appui:LinearProgress name="load-bar" class="load-bar" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= NEW GAME CONFIRM ================= -->
        <ui:VisualElement name="screen-newgame" class="screen screen--overlay">
            <ui:VisualElement class="dim-bg" />
            <ui:VisualElement class="wood-frame wood-frame--narrow wood-frame--centered">
                <ui:Label text="Начать заново?" class="frame-title" />
                <ui:Label text="Прогресс текущего сохранения будет стёрт. Грядка, рецепты, очки — всё обнулится." class="frame-subtitle frame-subtitle--warning" />

                <ui:VisualElement class="form-actions form-actions--vertical">
                    <ui:VisualElement name="btn-newgame-yes" class="wood-btn wood-btn--block">
                        <ui:Label text="Да, начать" class="wood-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-newgame-no" class="wood-btn wood-btn--block">
                        <ui:Label text="Отмена" class="wood-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </appui:Panel>
</UXML>
