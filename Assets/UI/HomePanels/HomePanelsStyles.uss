/* Shared Home panel style - Doska bulletin board */

.panel-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0);
    -unity-font: url("project://database/Assets/Resources/Menu/Fonts/arturito.ttf");
    -unity-font-definition: url("project://database/Assets/Resources/Menu/Fonts/arturito.ttf");
}
.panel-root > .appui-panel__main { background-color: rgba(0,0,0,0); }
.appui-panel__main { background-color: rgba(0,0,0,0); }

.dim-bg {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0,0,0,0.55);
    align-items: center;
    justify-content: center;
}

.doska-frame {
    width: 1000px;
    height: 770px;
    background-image: resource("Menu/DoskaUI");
    -unity-background-scale-mode: scale-to-fit;
    position: relative;
}

/* Cork writing zone (content lives here, over the bulletin board) */
.doska-content {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 27%;
    bottom: 8%;
    flex-direction: column;
    align-items: center;
}

/* Transparent hit-area over the red close button painted on the board (top-right) */
.doska-close {
    position: absolute;
    top: 8%;
    right: 3%;
    width: 64px;
    height: 64px;
}

.doska-title {
    color: #3a2412;
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    white-space: normal;
    text-shadow: 0 2px 5px rgba(0,0,0,0.85);
}

.doska-subtitle {
    color: #4a3018;
    font-size: 26px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
    white-space: normal;
}

.doska-body {
    color: #4a3018;
    font-size: 30px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 26px;
}

.doska-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.wood-btn {
    width: 300px;
    height: 104px;
    margin-left: 10px;
    margin-right: 10px;
    background-image: resource("Menu/btn");
    -unity-slice-left: 170;
    -unity-slice-right: 170;
    -unity-slice-top: 150;
    -unity-slice-bottom: 150;
    -unity-slice-scale: 0.42px;
    align-items: center;
    justify-content: center;
    transition: scale 0.12s ease-out;
}
.wood-btn:hover { scale: 1.04 1.04; }
.wood-btn:active { scale: 0.97 0.97; }

.wood-btn__label {
    color: #fbedc6;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 50px;
    padding-right: 50px;
    text-shadow: 0 3px 6px rgba(0,0,0,0.8);
}


/* ---------- Shop ---------- */
.shop-list {
    width: 100%;
    flex-grow: 1;
    margin-top: 6px;
    margin-bottom: 8px;
}
.shop-list .unity-scroller--vertical { width: 10px; }
.shop-list .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(74,48,24,0.8);
    border-radius: 5px;
}
.shop-list .unity-scroller--vertical .unity-scroller__low-button,
.shop-list .unity-scroller--vertical .unity-scroller__high-button { display: none; }

.shop-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    margin-bottom: 8px;
    margin-right: 8px;
    background-color: rgba(58, 40, 22, 0.55);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(40, 26, 14, 0.7);
    transition: scale 0.1s ease-out;
}
.shop-row:hover {
    background-color: rgba(86, 58, 30, 0.7);
    scale: 1.01 1.01;
}
.shop-row__name {
    color: #fff2d8;
    font-size: 26px;
    -unity-font-style: bold;
    flex-grow: 1;
    text-shadow: 0 1px 3px rgba(0,0,0,0.7);
}
.shop-row__price {
    color: #ffcf6b;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
}
