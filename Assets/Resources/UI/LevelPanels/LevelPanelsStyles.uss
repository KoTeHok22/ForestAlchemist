/* Level-scene App UI overlays */

.inv-frame {
    width: 980px;
    height: 1180px;
}

.inv-content {
    left: 14%;
    right: 14%;
    top: 22%;
    bottom: 30%;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
}

.inv-title {
    width: 100%;
    align-self: stretch;
    font-size: 46px;
    margin-bottom: 10px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    text-shadow: 0 3px 7px rgba(40, 24, 10, 0.95);
}

.inv-summary {
    width: 100%;
    align-self: stretch;
    font-size: 26px;
    margin-bottom: 12px;
    flex-shrink: 0;
    color: #fff0cc;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 2px 6px rgba(40, 24, 10, 0.95);
}

.inv-list {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    display: none;
}
.inv-list .unity-scroll-view__content-viewport {
    align-items: stretch;
}
.inv-list .unity-scroll-view__content-container {
    width: 100%;
    align-items: stretch;
}
.inv-list .unity-scroller--vertical { width: 8px; }
.inv-list .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(74,48,24,0.8);
    border-radius: 4px;
}
.inv-list .unity-scroller--vertical .unity-scroller__low-button,
.inv-list .unity-scroller--vertical .unity-scroller__high-button { display: none; }

.inv-empty-wrap {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: 8%;
    padding-right: 8%;
}

.inv-empty {
    width: 100%;
    color: #fff0cc;
    font-size: 28px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 12px;
    flex-shrink: 0;
    text-shadow: 0 2px 6px rgba(40, 24, 10, 0.95);
}

.inv-hint {
    width: 100%;
    color: #ecd5a6;
    font-size: 22px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
    text-shadow: 0 2px 5px rgba(40, 24, 10, 0.9);
}

/* Visible close button — top-right of the backpack frame */
.inv-close {
    position: absolute;
    top: 3.5%;
    right: 8%;
    width: 64px;
    height: 64px;
    background-color: rgba(150, 46, 30, 0.95);
    border-radius: 32px;
    border-width: 3px;
    border-color: rgba(60, 18, 12, 0.95);
    align-items: center;
    justify-content: center;
    transition: scale 0.1s ease-out;
}
.inv-close:hover { scale: 1.08 1.08; }
.inv-close__label {
    color: #fbedc6;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 3px rgba(0,0,0,0.8);
}

/* Full-screen weather tint (above world sprites, below HUD popups) */
.weather-fx-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0);
}
.weather-fx-root > .appui-panel__main { background-color: rgba(0,0,0,0); }

.weather-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Weather change notification board */
.weather-board {
    width: 760px;
    height: 520px;
}
.weather-board__content {
    top: 24%;
    bottom: 10%;
}
.weather-board__title {
    font-size: 44px;
    margin-bottom: 16px;
}
.weather-board__body {
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}
